# Copy to .env and fill in. Never commit .env.
# Mike uses ONE inference provider the user explicitly approved (Groq free tier).
# No automatic fallback: when the daily free quota is spent, Mike says so and stops.
GROQ_API_KEY=
NTFY_TOPIC=long-random-topic-name
AGENT_NAME=Mike
APPROVAL_REQUIRED=true
# Optional local cap on model requests per day (0 = no cap). Your own limit,
# not the provider's quota, which Mike cannot read.
MIKE_LOCAL_DAILY_CAP=0

# Shared secret the iPhone app must send as "Authorization: Bearer <token>".
# Set this BEFORE the core is reachable from anywhere but 127.0.0.1.
MIKE_TOKEN=

# Seconds before a model call gives up (garbage or <= 0 falls back to 60).
MIKE_GROQ_TIMEOUT=60
# Minutes between approvals-digest checks (minimum 1).
MIKE_DIGEST_MINUTES=15
